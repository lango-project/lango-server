export class Endpoint(spec)
    properties
        path
        module
        handler
        auth

Endpoint(spec)
    if !is_string(spec.path) or !spec.path.startsWith("/") or spec.path.includes("?") or spec.path.includes("#") or spec.path.includes("\\") or spec.path.includes("//")
        throw "Endpoint requires an absolute URL path"
    if spec.path.includes("*") and (!spec.path.endsWith("/*") or spec.path.indexOf("*") != spec.path.lastIndexOf("*"))
        throw "Only trailing /* wildcards are supported"
    for ["module", "handler"] as key
        if !is_string(spec[key]) or spec[key] == ""
            throw "Endpoint requires ${key}"
    @path = spec.path
    @module = spec.module
    @handler = spec.handler
    @auth = spec.auth
    if @auth == null
        @auth = "login"
    if !is_string(@auth) or @auth == "" or @auth.includes(",")
        throw "Endpoint auth must name one permission"

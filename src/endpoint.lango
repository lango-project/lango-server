import "./route_pattern"
    routePattern(path)
import "./middleware"
    middlewareName(name)

export class Endpoint(spec)
    properties
        path
        module
        handler
        auth
        middleware

Endpoint(spec)
    routePattern(spec.path)
    for ["module", "handler"] as key
        if !is_string(spec[key]) or spec[key] == ""
            throw "Endpoint requires ${key}"
    @path = spec.path
    @module = spec.module
    @handler = spec.handler
    @middleware = spec.middleware
    if @middleware != null
        middlewareName(@middleware)
    @auth = spec.auth
    if @auth == null
        @auth = "login"
    if !is_string(@auth) or @auth == "" or @auth.includes(",")
        throw "Endpoint auth must name one permission"

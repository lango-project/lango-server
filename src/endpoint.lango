import "./policy"
    policyOptions(spec)
import "./route_pattern"
    routePattern(path)
import "./middleware"
    middlewareName(name)

export class Endpoint(spec)
    properties
        path
        module
        handler
        auth
        policy
        reauthSeconds
        reauthExplicit
        legacyAuth
        middleware

Endpoint(spec)
    routePattern(spec.path)
    for ["module", "handler"] as key
        if !is_string(spec[key]) or spec[key] == ""
            throw "Endpoint requires ${key}"
    @path = spec.path
    @module = spec.module
    @handler = spec.handler
    @middleware = spec.middleware
    if @middleware != null
        middlewareName(@middleware)
    selected = policyOptions(spec)
    @policy = selected.name
    @auth = selected.name
    @reauthSeconds = selected.reauthSeconds
    @reauthExplicit = selected.explicit
    @legacyAuth = selected.legacy

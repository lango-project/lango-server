import "./server_context"
    class ServerContext
import "./database"
    class Database
import js global Promise
import js global JSON
import js global Object
import js global Date
import js "node:worker_threads" as threads
import "./token"
    class Token
import "./tokens"
    class Tokens
import "./response"
    class Response

export class Runtime(definition)
    methods
        preload()
        handle(task)
        close()

Runtime(definition)
    @serverContext = new ServerContext()
    @definition = definition
    @routes = []
    @events = {}
    @tokens = new Tokens(definition.settings)
    @modules = {}
    @database = new Database(definition.settings.database, definition.settings.root)

Runtime:preload()
    definitions = @definition.routes
    pending = @database.open()
    for definitions as route
        pending = prepareRoute(pending, route)
    events = @definition.events
    for events as name: target
        pending = prepareEvent(pending, name, target)
    return chain pending
      catch(error)
        close()
        throw error

Runtime:close()
    @database.close()
    return null

Runtime:prepareRoute(pending, route)
    if route.kind == "longpoll"
        @routes.add(route)
        return pending
    return chain pending
      then(ignored)
        capture route
        return target(route)
      then(handler)
        capture route
        @routes.add({
            path: route.path
            auth: route.auth
            handler: handler
        })
        return null

Runtime:prepareEvent(pending, name, spec)
    return chain pending
      then(ignored)
        capture spec
        return target(spec)
      then(handler)
        capture name
        @events[name] = handler
        return null

Runtime:target(spec)
    file = spec.module
    if file in @modules
        return Promise/resolve(exported(@modules[file], spec.handler))
    return chain import_module(file)
      then(mod)
        capture file
        capture spec
        @modules[file] = mod
        return exported(mod, spec.handler)

exported(mod, name)
    if !Object/hasOwn(mod, name) or !is_kindof(mod[name], Function)
        throw "Handler is not exported: ${name}"
    return mod[name]

Runtime:match(path)
    best = null
    length = -1
    for @routes as route
        if route.path == path
            return route
        if route.path.endsWith("/*")
            prefix = route.path.slice(0, -1)
            if path.startsWith(prefix) and prefix.length > length
                best = route
                length = prefix.length
    return best

Runtime:handle(task)
    Object/freeze(task.request.headers)
    context server = @serverContext
    context request = Object/freeze(task.request)
    context response = new Response()
    context log
    fresh = request.headers.authorization == null
    claims = null
    try
        if fresh
            claims = @tokens.create()
          else
              claims = @tokens.read(request.headers.authorization)
    catch error
        return failure(401, "Unauthorized")
    route = match(request.path)
    if route == null
        return failure(404, "RouteNotFound")
    input = null
    try
        input = JSON/parse(task.body)
        if !is_object(input) or is_array(input)
            return failure(400, "InputMustBeObject")
    catch error
        return failure(400, "InvalidJson")
    context token = new Token(claims)
    context db = @database.scope()
    return chain Promise/resolve(null)
      then(ignored)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture fresh
        capture input
        if fresh
            return event("register", input)
        return validate()
      then(validatedAt)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture route
        capture input
        capture claims
        capture fresh
        if !fresh and is_number(validatedAt)
            stampValidation(claims, validatedAt)
        if route.auth != "anonymous" and !token.hasAuth(route.auth)
            throw {
                status: 401
                error: "Unauthorized"
            }
        if route.kind == "longpoll"
            return null
        handler = route.handler
        return handler(input)
      then(output)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture task
        capture claims
        if task.authorize == true
            closeScope(db, true)
            authorizedClaims = token.snapshot()
            authorizedClaims.validatedAt = claims.validatedAt
            encoded = @tokens.sign(authorizedClaims)
            if task.pollResult == null
                return {
                    status: 200
                    authorization: encoded
                }
            if task.pollResult.resyncRequired
                response.status(409)
            pollBody = JSON/stringify(task.pollResult)
            pollResponse = response.result(pollBody)
            pollResponse.headers["x-lango-token"] = encoded
            if @definition.settings.requestEvent and "request" in @events
                return audit(request.id, pollResponse, task.body, pollBody, authorizedClaims)
            return pollResponse
        body = JSON/stringify(output)
        if !is_string(body)
            throw "Handler result is not JSON serializable"
        closeScope(db, true)
        result = response.result(body)
        updated = token.snapshot()
        updated.validatedAt = claims.validatedAt
        result.headers["x-lango-token"] = @tokens.sign(updated)
        if @definition.settings.requestEvent and "request" in @events
            return audit(request.id, result, task.body, body, updated)
        return result
      catch(error)
        capture server
        capture request
        capture log
        capture db
        closeScope(db, false)
        if error == "TokenExpired" or (is_object(error) and error.status == 401)
            return failure(401, "Unauthorized")
        log.err("[${request.id}] Request failed")
        return failure(500, "InternalServerError")
      finally
        capture db
        closeScope(db, false)

Runtime:event(name, input)
    if !(name in @events)
        return null
    context server
    context request
    context response
    context token
    context log
    context db
    handler = @events[name]
    threads/parentPort/postMessage({
        kind: "event"
        id: request.id
    })
    return chain Promise/resolve(null)
      then(ignored)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture handler
        capture input
        return handler(input)
      finally
        capture server
        capture request
        capture threads
        threads/parentPort/postMessage({
            kind: "handler"
            id: request.id
        })

Runtime:validate()
    context db
    context token
    context response
    context server
    context request
    context log
    claims = token.snapshot()
    if !("validate" in @events) or Date/now() - claims.validatedAt < 1000
        return null
    original = JSON/stringify(claims)
    context token = new Token(claims, true)
    return chain Promise/resolve(null)
      then(ignored)
        capture token
        capture response
        capture server
        capture request
        capture log
        capture db
        return event("validate", null)
      then(valid)
        capture token
        capture original
        capture claims
        if !is_bool(valid)
            throw "Validate must return boolean"
        if !valid
            throw {
                status: 401
                error: "Unauthorized"
            }
        if JSON/stringify(token.snapshot()) != original
            throw "Validate cannot change the token"
        claims.validatedAt = Date/now()
        return claims.validatedAt

Runtime:audit(id, result, input, output, claims)
    context db = @database.scope()
    context server
    context request
    context log
    context token = new Token(claims, true)
    context response = Object/freeze({})
    metadata = {
        input: input
        output: output
        status: result.status
    }
    threads/parentPort/postMessage({
        kind: "prepared"
        id: id
        result: result
    })
    return chain Promise/resolve(null)
      then(ignored)
        capture token
        capture server
        capture request
        capture response
        capture log
        capture db
        capture metadata
        return event("request", Object/freeze(metadata))
      then(ignored)
        capture db
        closeScope(db, true)
        return null
      catch(error)
        capture log
        capture db
        closeScope(db, false)
        log.err("Request event failed")
        return null
      then(ignored)
        capture result
        return result
      finally
        capture db
        closeScope(db, false)

failure(status, code)
    headers = {
        "content-type": "application/json; charset=utf-8"
        "cache-control": "no-store"
    }
    if status == 401
        headers["www-authenticate"] = "Bearer"
    return {
        status: status
        headers: headers
        body: JSON/stringify({
            error: code
        })
    }

stampValidation(claims, validatedAt)
    claims.validatedAt = validatedAt
    return null

closeScope(db, strict)
    if db != null
        dirty = db.finish()
        if dirty and strict
            throw "UnclosedTransaction"
    return null

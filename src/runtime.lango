import "./route_pattern"
    routePattern(path)
    matchPath(pattern, path)
    moreSpecific(candidate, current)
import js global decodeURIComponent
import "./server_context"
    class ServerContext
import "./database"
    class Database
import js global Promise
import js global JSON
import js global Object
import js global Date
import js "node:worker_threads" as threads
import "./token"
    class Token
import "./tokens"
    class Tokens
import "./response"
    class Response
import "./http_failure"
    class HttpFailure

export class Runtime(definition)
    methods
        preload()
        handle(task)
        close()
        refreshTokens(tokens)

Runtime(definition)
    refresh = (tokens)
        return refreshTokens(tokens)
    @serverContext = new ServerContext(definition.routes, refresh)
    @definition = definition
    @routes = []
    @events = {}
    @tokens = new Tokens(definition.settings)
    @modules = {}
    @middlewares = Object/create(null)
    @database = new Database(definition.settings.database, definition.settings.root)

Runtime:preload()
    definitions = @definition.routes
    pending = @database.open()
    if @definition.middlewares != null
        for @definition.middlewares as name: spec
            pending = prepareMiddleware(pending, name, spec)
    for definitions as route
        pending = prepareRoute(pending, route)
    events = @definition.events
    for events as name: target
        pending = prepareEvent(pending, name, target)
    return chain pending
      catch(error)
        close()
        throw error

Runtime:close()
    @database.close()
    return null

Runtime:prepareMiddleware(pending, name, spec)
    return chain pending
      then(ignored)
        capture spec
        return target(spec)
      then(handler)
        capture name
        capture spec
        @middlewares[name] = handler
        if spec.validate != null
            return target({
                module: spec.module
                handler: spec.validate
            })
        return null
      then(validator)
        if validator != null
            return validator(@serverContext.routes())
        return null

Runtime:prepareRoute(pending, route)
    if route.kind == "longpoll"
        prepared = Object/assign({}, route)
        prepared.pattern = routePattern(route.path)
        @routes.add(prepared)
        return pending
    return chain pending
      then(ignored)
        capture route
        return target(route)
      then(handler)
        capture route
        middleware = null
        name = route.middleware
        if name != null
            if !Object/hasOwn(@middlewares, name)
                throw "Middleware is not registered: ${name}"
            middleware = @middlewares[name]
        @routes.add({
            path: route.path
            pattern: routePattern(route.path)
            auth: route.auth
            handler: handler
            middleware: middleware
        })
        return null

Runtime:prepareEvent(pending, name, spec)
    return chain pending
      then(ignored)
        capture spec
        return target(spec)
      then(handler)
        capture name
        @events[name] = handler
        return null

Runtime:target(spec)
    file = spec.module
    if file in @modules
        return Promise/resolve(exported(@modules[file], spec.handler))
    return chain import_module(file)
      then(mod)
        capture file
        capture spec
        @modules[file] = mod
        return exported(mod, spec.handler)

exported(mod, name)
    if !Object/hasOwn(mod, name) or !is_kindof(mod[name], Function)
        throw "Handler is not exported: ${name}"
    return mod[name]

Runtime:match(path)
    best = null
    parameters = null
    pattern = null
    for @routes as route
        captured = matchPath(route.pattern, path)
        if captured != null and moreSpecific(route.pattern, pattern)
            best = route
            parameters = captured
            pattern = route.pattern
    if best == null
        return null
    return {
        route: best
        parameters: parameters
    }

Runtime:handle(task)
    Object/freeze(task.request.headers)
    context server = @serverContext
    context request = Object/freeze(task.request)
    context response = new Response()
    context log
    fresh = request.headers.authorization == null
    claims = null
    try
        if fresh
            claims = @tokens.create()
          else
              claims = @tokens.read(request.headers.authorization)
    catch error
        return failure(401, "Unauthorized")
    matched = match(request.path)
    if matched == null
        return failure(404, "RouteNotFound")
    route = matched.route
    input = null
    try
        input = JSON/parse(task.body)
        if !is_object(input) or is_array(input)
            return failure(400, "InputMustBeObject")
    catch error
        return failure(400, "InvalidJson")
    try
        for matched.parameters as name: value
            input[name] = decodeURIComponent(value)
    catch error
        return failure(400, "InvalidPath")
    context token = new Token(claims)
    context db = @database.scope()
    return chain Promise/resolve(null)
      then(ignored)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture fresh
        capture input
        if fresh
            return event("register", input)
        return validate()
      then(validatedAt)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture route
        capture input
        capture claims
        capture fresh
        if !fresh and is_number(validatedAt)
            stampValidation(claims, validatedAt)
            token.renew()
        if route.auth != "anonymous" and !token.hasAuth(route.auth)
            throw {
                status: 401
                error: "Unauthorized"
            }
        if route.kind == "longpoll"
            return null
        handler = route.handler
        middleware = route.middleware
        if middleware != null
            return middleware(handler, request.path, input)
        return handler(input)
      then(output)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture task
        capture claims
        if task.authorize == true
            closeScope(db, true)
            authorizedClaims = tokenClaims(token, claims, true)
            encoded = @tokens.sign(authorizedClaims)
            if task.pollResult == null
                return {
                    status: 200
                    authorization: encoded
                }
            if task.pollResult.resyncRequired
                response.status(409)
            pollBody = JSON/stringify(task.pollResult)
            pollResponse = response.result(pollBody)
            pollResponse.headers["x-lango-token"] = encoded
            if @definition.settings.requestEvent and "request" in @events
                return audit(request.id, pollResponse, task.body, pollBody, authorizedClaims)
            return pollResponse
        body = JSON/stringify(output)
        if !is_string(body)
            throw "Handler result is not JSON serializable"
        closeScope(db, true)
        result = response.result(body)
        updated = tokenClaims(token, claims, result.status < 400)
        result.headers["x-lango-token"] = @tokens.sign(updated)
        if task.internal != true and @definition.settings.requestEvent and "request" in @events
            return audit(request.id, result, task.body, body, updated)
        return result
      catch(error)
        capture server
        capture request
        capture log
        capture db
        capture HttpFailure
        closeScope(db, false)
        if is_kindof(error, HttpFailure)
            return error.result()
        if error == "TokenExpired" or (is_object(error) and error.status == 401)
            return failure(401, "Unauthorized")
        log.err("[${request.id}] Request failed")
        return failure(500, "InternalServerError")
      finally
        capture db
        closeScope(db, false)

Runtime:tokenClaims(token, claims, allowRenewal)
    updated = token.snapshot()
    updated.validatedAt = claims.validatedAt
    if allowRenewal and token.renewalRequested()
        updated = @tokens.renew(updated)
    return updated

Runtime:refreshTokens(tokens)
    context request
    context token
    if !is_array(tokens) or tokens.length == 0 or tokens.length > 64
        throw "Token refresh requires 1 to 64 tokens"
    seen = []
    for tokens as encoded
        if !is_string(encoded) or encoded == "" or encoded.length > 16384 or seen.includes(encoded)
            throw "Invalid refresh token"
        seen.add(encoded)
    owner = token.clientId?
    results = []
    pending = Promise/resolve(null)
    for tokens as encoded
        child = Object/assign({}, request, {
            headers: Object/assign({}, request.headers, {
                authorization: "Bearer ${encoded}"
            })
        })
        pending = refreshOne(pending, results, encoded, owner, child)
    return chain pending
      then(ignored)
        capture results
        return results

Runtime:refreshOne(pending, results, encoded, owner, child)
    return chain pending
      then(ignored)
        capture encoded
        capture owner
        capture child
        checked = null
        try
            checked = @tokens.read("Bearer ${encoded}")
        catch error
            return failure(401, "Unauthorized")
        if checked.clientId != owner
            return failure(401, "Unauthorized")
        return handle({
            request: child
            body: "{}"
            internal: true
        })
      then(result)
        capture results
        capture encoded
        updated = null
        if result.status < 400
            updated = result.headers["x-lango-token"]
        results.add({
            previous: encoded
            token: updated
            status: result.status
        })
        return null

Runtime:event(name, input)
    if !(name in @events)
        return null
    context server
    context request
    context response
    context token
    context log
    context db
    handler = @events[name]
    threads/parentPort/postMessage({
        kind: "event"
        id: request.id
    })
    return chain Promise/resolve(null)
      then(ignored)
        capture server
        capture request
        capture response
        capture token
        capture log
        capture db
        capture handler
        capture input
        return handler(input)
      finally
        capture server
        capture request
        capture threads
        threads/parentPort/postMessage({
            kind: "handler"
            id: request.id
        })

Runtime:validate()
    context db
    context token
    context response
    context server
    context request
    context log
    claims = token.snapshot()
    if Date/now() - claims.validatedAt < 1000
        return null
    if !("validate" in @events)
        return Date/now()
    original = JSON/stringify(claims)
    context token = new Token(claims, true)
    return chain Promise/resolve(null)
      then(ignored)
        capture token
        capture response
        capture server
        capture request
        capture log
        capture db
        return event("validate", null)
      then(valid)
        capture token
        capture original
        capture claims
        if !is_bool(valid)
            throw "Validate must return boolean"
        if !valid
            throw {
                status: 401
                error: "Unauthorized"
            }
        if JSON/stringify(token.snapshot()) != original
            throw "Validate cannot change the token"
        claims.validatedAt = Date/now()
        return claims.validatedAt

Runtime:audit(id, result, input, output, claims)
    context db = @database.scope()
    context server
    context request
    context log
    context token = new Token(claims, true)
    context response = Object/freeze({})
    metadata = {
        input: input
        output: output
        status: result.status
    }
    threads/parentPort/postMessage({
        kind: "prepared"
        id: id
        result: result
    })
    return chain Promise/resolve(null)
      then(ignored)
        capture token
        capture server
        capture request
        capture response
        capture log
        capture db
        capture metadata
        return event("request", Object/freeze(metadata))
      then(ignored)
        capture db
        closeScope(db, true)
        return null
      catch(error)
        capture log
        capture db
        closeScope(db, false)
        log.err("Request event failed")
        return null
      then(ignored)
        capture result
        return result
      finally
        capture db
        closeScope(db, false)

failure(status, code)
    headers = {
        "content-type": "application/json; charset=utf-8"
        "cache-control": "no-store"
    }
    if status == 401
        headers["www-authenticate"] = "Bearer"
    return {
        status: status
        headers: headers
        body: JSON/stringify({
            error: code
        })
    }

stampValidation(claims, validatedAt)
    claims.validatedAt = validatedAt
    return null

closeScope(db, strict)
    if db != null
        dirty = db.finish()
        if dirty and strict
            throw "UnclosedTransaction"
    return null

import "./options"
    contains(items, value)
import js global Object

export class Token(claims, readonly = false)
    properties
        clientId?
        auth?
        policies?
        expiresAt?
    methods
        addPolicy(permission)
        hasPolicy(permission)
        clearPolicies()
        AddAuth(permission)
        clearAuth()
        hasAuth(permission)
        get(name)
        set(name, value)
        snapshot()
        renew()
        renewalRequested()

Token(claims, readonly = false)
    @claims = from_json(to_json(claims))
    @readonly = readonly
    @renew = false
    @clientId = claims.clientId
    @auth = claims.auth
    @expiresAt = claims.exp
    Object/freeze(@this)

Token:clientId?
    return @clientId

Token:auth?
    return @auth

Token:expiresAt?
    return @expiresAt

Token:addPolicy(permission)
    writable()
    if !is_string(permission) or permission.trim() == "" or permission.includes(",")
        throw "Permission must be a nonempty name without commas"
    permission = permission.trim()
    if !hasPolicy(permission)
        if @auth == ""
            @auth = permission
          else
              @auth = "${@auth}, ${permission}"
    return @this

Token:clearPolicies()
    writable()
    @auth = ""
    return @this

Token:hasPolicy(permission)
    for @auth.split(",") as name
        if name.trim() == permission
            return true
    return false

Token:policies?
    result = []
    for @auth.split(",") as name
        value = name.trim()
        if value != ""
            result.add(value)
    return result

Token:AddAuth(permission)
    return addPolicy(permission)

Token:hasAuth(permission)
    return hasPolicy(permission)

Token:clearAuth()
    return clearPolicies()

Token:get(name)
    if !Object/hasOwn(@claims, name)
        return null
    return from_json(to_json(@claims[name]))

Token:set(name, value)
    writable()
    if contains(["clientProof", "clientId", "auth", "iat", "exp", "iss", "aud", "validatedAt", "nbf", "__proto__", "constructor", "prototype"], name)
        throw "Reserved token field: ${name}"
    @claims[name] = from_json(to_json(value))
    return @this

Token:snapshot()
    claims = from_json(to_json(@claims))
    if @clientId != claims.clientId or @expiresAt != claims.exp or !is_string(@auth)
        throw "Token identity and expiry cannot be changed"
    claims.auth = @auth
    return claims

Token:renew()
    writable()
    @renew = true
    return @this

Token:renewalRequested()
    return @renew

Token:writable()
    if @readonly
        throw "Token is read-only during this event"
    return null

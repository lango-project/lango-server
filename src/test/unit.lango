settings()
    return options(process.cwd(), {
        key: "01234567890123456789012345678901"
    })

fixture()
    dir = fs/mkdtempSync(path/join(process.cwd(), ".test-output", "routes-"))
    fs/writeFileSync(path/join(dir, "package.json"), to_json({
        private: true
    }))
    fs/writeFileSync(path/join(dir, "handler.mjs"), "")
    return dir

expectFailure(action)
    failed = false
    try
        action()
    catch error
        failed = true
    assert failed
    return null

test "configuration has bounded defaults and rejects unknown or unsafe options"
    config = settings()
    assert config.workers == 2
    assert config.bodyLimit == 2097152
    values = [-1, 0, 129, 2147483648, 1, "short"]
    for ["port", "workers", "workers", "requestTimeoutMs", "typo", "key"] as index: name
        spec = {
            key: "01234567890123456789012345678901"
        }
        spec[name] = values[index]
        action = ()
            capture spec
            options(process.cwd(), spec)
        expectFailure(action)

test "deployment XML resolves environment keys and rejects typos"
    dir = fixture()
    try
        process.env.LANGO_SERVER_TEST_KEY = "01234567890123456789012345678901"
        xml = <deploy>
            <http port="0"/>
            <static path="/assets" directory="./public" index="home.html"/>
            <workers workers="1" maxQueue="0"/>
            <events requestEvent="true" eventTimeoutMs="250"/>
            <jwt keyEnv="LANGO_SERVER_TEST_KEY"/>
        </deploy>
        file = path/join(dir, "deploy.xml")
        fs/writeFileSync(file, "${xml}")
        config = deployment(dir)
        assert config.port == 0
        assert config.workers == 1
        assert config.requestEvent == true
        assert config.static.path == "/assets"
        assert config.static.directory == path/join(dir, "public")
        assert config.static.index == "home.html"
        xml = <deploy><workers typo="1"/></deploy>
        fs/writeFileSync(file, "${xml}")
        action = ()
            capture dir
            deployment(dir)
        expectFailure(action)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "static configuration defaults are optional and unsafe or unknown settings fail"
    assert settings().static == null
    config = options(process.cwd(), {
        key: "01234567890123456789012345678901"
        static: {
            directory: "public"
        }
    })
    assert config.static.path == "/"
    assert config.static.index == "index.html"
    assert config.static.directory == path/resolve("public")
    cases = []
    cases.add([])
    cases.add({
        directory: ""
    })
    cases.add({
        directory: "public"
        path: "relative"
    })
    cases.add({
        directory: "public"
        path: "/../outside"
    })
    cases.add({
        directory: "public"
        index: "../private"
    })
    cases.add({
        directory: "public"
        handler: "started"
    })
    for cases as spec
        action = ()
            capture spec
            options(process.cwd(), {
                key: "01234567890123456789012345678901"
                static: spec
            })
        expectFailure(action)

test "route XML groups inherit module and auth; duplicate paths and missing modules fail"
    dir = fixture()
    try
        file = path/join(dir, "routes.xml")
        xml = <routes>
            <group path="/math" module="./handler.mjs" auth="anonymous">
                <endpoint path="/add" handler="run"/>
                <group path="/nested"><endpoint path="/run" handler="run"/></group>
            </group>
        </routes>
        fs/writeFileSync(file, "${xml}")
        routes = new Routes(dir)
        routes.xml(file)
        values = routes.definitions()
        assert values.length == 2
        assert values[0].path == "/math/add"
        assert values[1].auth == "anonymous"
        duplicate = ()
            capture path
            capture routes
            capture dir
            routes.endpoint({
                path: "/math/add"
                module: path/join(dir, "handler.mjs")
                handler: "run"
            })
        expectFailure(duplicate)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "package includes use exported XML, compose prefixes and allow repeated mounts"
    dir = fixture()
    try
        pkg = path/join(dir, "node_modules", "feature")
        fs/mkdirSync(pkg, {
            recursive: true
        })
        fs/writeFileSync(path/join(pkg, "package.json"), to_json({
            name: "feature"
            type: "module"
            exports: {
                ".": "./handler.mjs"
                "./routes.xml": "./routes.xml"
            }
        }))
        fs/writeFileSync(path/join(pkg, "handler.mjs"), "")
        xml = <routes><endpoint path="/run" module="feature" handler="run"/></routes>
        fs/writeFileSync(path/join(pkg, "routes.xml"), "${xml}")
        routes = new Routes(dir)
        routes.include({
            module: "feature"
            path: "/a"
        })
        routes.include({
            module: "feature"
            path: "/b"
        })
        values = routes.definitions()
        assert values[0].path == "/a/run"
        assert values[1].path == "/b/run"
        group = new Group(routes, {
            path: "/group"
            module: "feature"
            auth: "anonymous"
        })
        group.include({
            module: "feature"
        })
        group.endpoint({
            path: "/local"
            handler: "run"
        })
        grouped = routes.definitions()
        assert grouped[2].path == "/group/run"
        assert grouped[2].auth == "anonymous"
        assert grouped[3].path == "/group/local"
        assert grouped[3].auth == "anonymous"
        xml = <routes><include module="feature" path="/again"/></routes>
        fs/writeFileSync(path/join(pkg, "routes.xml"), "${xml}")
        action = ()
            capture dir
            other = new Routes(dir)
            other.include({
                module: "feature"
                path: "/cycle"
            })
        expectFailure(action)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "Token properties are getter-only while controlled mutation methods remain usable"
    service = new Tokens(settings())
    claims = service.create()
    token = new Token(claims)
    assert token.clientId? == claims.clientId
    assert token.auth? == ""
    assert token.expiresAt? == claims.exp
    assert Object/isFrozen(token)
    for ["clientId", "auth", "expiresAt"] as name
        descriptor = Object/getOwnPropertyDescriptor(Token.prototype, name)
        assert is_kindof(descriptor.get, Function)
        assert descriptor.set == null
        assert !Reflect/set(token, name, "changed")
    shadow = ()
        capture token
        Object/defineProperty(token, "auth", {
            value: "admin"
        })
    expectFailure(shadow)
    token.AddAuth("login")
    assert token.auth? == "login"
    token.set("state", {
        counter: 1
    })
    detached = token.get("state")
    detached.counter = 2
    stored = token.get("state")
    assert stored.counter == 1
    token.clearAuth()
    assert token.auth? == ""
    assert token.clientId? == claims.clientId
    assert token.expiresAt? == claims.exp

test "readonly event Tokens reject claim and permission changes"
    service = new Tokens(settings())
    locked = new Token(service.create(), true)
    changeClaim = ()
        capture locked
        locked.set("state", "changed")
    changeAuth = ()
        capture locked
        locked.AddAuth("admin")
    expectFailure(changeClaim)
    expectFailure(changeAuth)
    assert locked.auth? == ""
    assert locked.get("state") == null

test "JWT verifies signature expiry issuer audience and exact auth memberships"
    service = new Tokens(settings())
    claims = service.create()
    token = new Token(claims)
    token.AddAuth("login").AddAuth("superadmin")
    assert token.hasAuth("login")
    assert !token.hasAuth("admin")
    signed = service.sign(token.snapshot())
    read = service.read("Bearer ${signed}")
    assert read.clientId == claims.clientId
    action = ()
        capture service
        capture signed
        service.read("Bearer ${signed}invalid")
    expectFailure(action)
    expired = token.snapshot()
    expired.exp = 1
    expiredAction = ()
        capture service
        capture expired
        service.sign(expired)
    expectFailure(expiredAction)
    token.clearAuth()
    assert !token.hasAuth("login")
    original = service.read("Bearer ${signed}")
    assert original.auth == "login, superadmin"


test "database configuration is optional, strict and resolves application-relative SQLite paths"
    config = settings()
    assert config.database == null
    root = process.cwd()
    config = options(root, {
        key: "01234567890123456789012345678901"
        database: {
            type: "sqlite"
            file: "data/application.sqlite"
        }
    })
    assert config.database.file == path/resolve(root, "data/application.sqlite")
    bad = ()
        options(process.cwd(), {
            key: "01234567890123456789012345678901"
            database: {
                type: "sqlite"
                file: ":memory:"
            }
        })
    expectFailure(bad)
    dir = fixture()
    process.env.LANGO_SERVER_TEST_KEY = "01234567890123456789012345678901"
    try
        xml = <deploy>
            <jwt keyEnv="LANGO_SERVER_TEST_KEY"/>
            <database type="sqlite" file="data/app.sqlite" busyTimeoutMs="250"/>
        </deploy>
        fs/writeFileSync(path/join(dir, "deploy.xml"), "${xml}")
        loaded = deployment(dir)
        assert loaded.database.type == "sqlite"
        assert loaded.database.file == path/join(dir, "data/app.sqlite")
        assert loaded.database.busyTimeoutMs == 250
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "longpoll XML and Builder groups inherit auth and compose fallback prefixes"
    dir = fixture()
    try
        pkg = path/join(dir, "node_modules", "feature")
        fs/mkdirSync(pkg, {
            recursive: true
        })
        fs/writeFileSync(path/join(pkg, "package.json"), to_json({
            name: "feature"
            exports: {
                "./routes.xml": "./routes.xml"
            }
        }))
        xml = <routes>
            <group path="/nested" auth="admin">
                <longpoll path="/updates" fallback="/state" waitTimeoutMs="50"/>
            </group>
        </routes>
        fs/writeFileSync(path/join(pkg, "routes.xml"), "${xml}")
        routes = new Routes(dir)
        routes.include({
            module: "feature"
            path: "/app"
        })
        definitions = routes.definitions()
        assert definitions[0].path == "/app/nested/updates"
        assert definitions[0].fallback == "/app/nested/state"
        assert definitions[0].auth == "admin"
        assert definitions[0].waitTimeoutMs == 50
        group = new Group(routes, {
            path: "/builder"
            auth: "anonymous"
        })
        group.longpoll({
            path: "/updates"
            fallback: "/state"
        })
        definitions = routes.definitions()
        assert definitions[1].fallback == "/builder/state"
        assert definitions[1].auth == "anonymous"
        duplicate = ()
            capture routes
            routes.longpoll({
                path: "/builder/updates"
            })
        expectFailure(duplicate)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "longpoll rejects wildcards, unsafe limits, and missing Redis configuration"
    for ["/bad/*", "/bad?query", "relative"] as value
        bad = ()
            capture value
            routes = new Routes(process.cwd())
            routes.longpoll({
                path: value
            })
        expectFailure(bad)
    for [0, -1, 60001, true, "wrong"] as value
        bad = ()
            capture value
            routes = new Routes(process.cwd())
            routes.longpoll({
                path: "/updates"
                waitTimeoutMs: value
            })
        expectFailure(bad)
    missing = ()
        builder = new Builder(process.cwd())
        builder.configure({
            key: "01234567890123456789012345678901"
        })
        builder.longpoll({
            path: "/updates"
        })
        builder.build()
    expectFailure(missing)

test "middleware declarations are order independent and custom routes retain group defaults"
    dir = fixture()
    try
        xml = <routes>
            <group path="/app" module="./handler.mjs" auth="anonymous">
                <ui path="/run" handler="run"/>
            </group>
            <middleware name="ui" module="./handler.mjs" handler="wrap" validate="checkRoutes"/>
        </routes>
        file = path/join(dir, "routes.xml")
        fs/writeFileSync(file, "${xml}")
        routes = new Routes(dir)
        routes.xml(file)
        definitions = routes.definitions()
        assert definitions[0].path == "/app/run"
        assert definitions[0].auth == "anonymous"
        assert definitions[0].middleware == "ui"
        registered = routes.middlewares()
        assert registered.ui.handler == "wrap"
        assert registered.ui.validate == "checkRoutes"
        registered.ui.handler = "changed"
        current = routes.middlewares()
        assert current.ui.handler == "wrap"
        group = new Group(routes, {
            path: "/group"
            module: path/join(dir, "handler.mjs")
            auth: "anonymous"
        })
        group.endpoint({
            path: "/run"
            handler: "run"
            middleware: "ui"
        })
        definitions = routes.definitions()
        assert definitions[1].middleware == "ui"
        assert definitions[1].path == "/group/run"
        duplicate = ()
            capture routes
            routes.addMiddleware("ui", {
                module: "./handler.mjs"
                handler: "wrap"
            })
        expectFailure(duplicate)
        nested = <routes>
            <group path="/nested">
                <middleware name="other" module="./handler.mjs" handler="wrap"/>
            </group>
        </routes>
        fs/writeFileSync(file, "${nested}")
        bad = ()
            capture dir
            capture file
            other = new Routes(dir)
            other.xml(file)
        expectFailure(bad)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "middleware names, descriptors and XML attributes reject unsupported definitions"
    dir = fixture()
    try
        routes = new Routes(dir)
        for ["", "routes", "endpoint", "longpoll", "group", "include", "event", "middleware", "bad name", "a:b", 42] as name
            bad = ()
                capture routes
                capture name
                routes.addMiddleware(name, {
                    module: "./handler.mjs"
                    handler: "wrap"
                })
            expectFailure(bad)
        badSpec = ()
            capture routes
            routes.addMiddleware("ui", {
                module: "./handler.mjs"
                handler: "wrap"
                typo: true
            })
        expectFailure(badSpec)
        badEndpoint = ()
            capture routes
            routes.endpoint({
                path: "/run"
                module: "./handler.mjs"
                handler: "run"
                middleware: ""
            })
        expectFailure(badEndpoint)
        unknown = <routes><ui path="/run" module="./handler.mjs" handler="run" typo="wrong"/></routes>
        rejectRoutesXml(dir, unknown)
        duplicateSelection = <routes><ui path="/run" module="./handler.mjs" handler="run" middleware="other"/></routes>
        rejectRoutesXml(dir, duplicateSelection)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })


rejectRoutesXml(dir, xml)
    file = path/join(dir, "routes.xml")
    fs/writeFileSync(file, "${xml}")
    bad = ()
        capture dir
        capture file
        routes = new Routes(dir)
        routes.xml(file)
    expectFailure(bad)
    return null

test "included custom routes share root middleware without permitting package registrations"
    dir = fixture()
    try
        pkg = path/join(dir, "node_modules", "feature")
        fs/mkdirSync(pkg, {
            recursive: true
        })
        fs/writeFileSync(path/join(pkg, "package.json"), to_json({
            name: "feature"
            exports: {
                ".": "./handler.mjs"
                "./routes.xml": "./routes.xml"
            }
        }))
        fs/writeFileSync(path/join(pkg, "handler.mjs"), "")
        included = <routes><ui path="/run" module="feature" handler="run"/></routes>
        fs/writeFileSync(path/join(pkg, "routes.xml"), "${included}")
        root = <routes>
            <group path="/app" auth="anonymous">
                <include module="feature" path="/a"/>
                <include module="feature" path="/b"/>
            </group>
            <middleware name="ui" module="./handler.mjs" handler="wrap"/>
        </routes>
        file = path/join(dir, "routes.xml")
        fs/writeFileSync(file, "${root}")
        routes = new Routes(dir)
        routes.xml(file)
        definitions = routes.definitions()
        assert definitions[0].path == "/app/a/run"
        assert definitions[1].path == "/app/b/run"
        assert definitions[0].middleware == "ui"
        assert definitions[1].auth == "anonymous"
        forbidden = <routes><middleware name="ui" module="feature" handler="wrap"/></routes>
        fs/writeFileSync(path/join(pkg, "routes.xml"), "${forbidden}")
        bad = ()
            capture dir
            capture file
            other = new Routes(dir)
            other.xml(file)
        expectFailure(bad)
    finally
        fs/rmSync(dir, {
            recursive: true
            force: true
        })

test "server route metadata is an independent snapshot without module or handler details"
    definitions = []
    definitions.add({
        path: "/ui"
        auth: "anonymous"
        middleware: "ui"
        module: "/private/handlers.mjs"
        handler: "secret"
    })
    server = new ServerContext(definitions)
    first = server.routes()
    assert first[0].path == "/ui"
    assert first[0].kind == "endpoint"
    assert !Object/hasOwn(first[0], "module")
    assert !Object/hasOwn(first[0], "handler")
    route = first[0]
    route.path = "/changed"
    second = server.routes()
    assert second[0].path == "/ui"

test "token renewal preserves identity and the last real validation timestamp"
    config = settings()
    service = new Tokens(config)
    claims = service.create()
    claims.iat = claims.iat - 120
    claims.exp = claims.iat + config.ttlSeconds
    claims.validatedAt = Date/now() - 100000
    token = new Token(claims)
    token.AddAuth("login")
    token.set("sessionId", "session")
    assert token.renew() == token
    assert token.renewalRequested()
    before = token.snapshot()
    assert before.exp == claims.exp
    updated = service.renew(before)
    assert updated.exp > before.exp
    assert updated.clientId == before.clientId
    assert updated.sessionId == "session"
    assert updated.auth == "login"
    assert updated.validatedAt == before.validatedAt
    checked = service.read("Bearer ${service.sign(updated)}")
    assert checked.exp == updated.exp
    assert checked.validatedAt == before.validatedAt
    readonly = ()
        capture claims
        locked = new Token(claims, true)
        locked.renew()
    expectFailure(readonly)
    expired = ()
        capture claims
        capture service
        old = from_json(to_json(claims))
        old.exp = 1
        service.renew(old)
    expectFailure(expired)

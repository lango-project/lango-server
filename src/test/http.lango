import js "node:http" as http
import js "@lango-project/lango-server" as api
import js "node:path" as path
import js "node:fs" as fs
import js "node:assert/strict" as check
import js global Object
import js global Promise
import js global process
import js global fetch
import js global Date
import js global setTimeout
import "../options"
    options(root, supplied = null)
import "../token"
    class Token
import "../tokens"
    class Tokens

withServer(extra, run)
    builder = new api/Builder(process.cwd())
    settings = {
        port: 0
        key: "01234567890123456789012345678901"
        workers: 1
        eventTimeoutMs: 150
        requestTimeoutMs: 2000
        shutdownTimeoutMs: 1000
    }
    Object/assign(settings, extra)
    builder.configure(settings)
    module = path/resolve(".test-output/handlers.mjs")
    for ["echo", "login", "logout", "fail", "pause", "crash", "circular", "serialized", "renew", "rejectReply"] as name
        builder.endpoint({
            path: "/${name}"
            module: module
            handler: name
            auth: "anonymous"
        })
    for [["/policy/login", "login", 0], ["/policy/admin", "admin", 0], ["/policy/fresh", "login", 60]] as spec
        builder.endpoint({
            path: spec[0]
            module: module
            handler: "policyEcho"
            policy: spec[1]
            reauthSeconds: spec[2]
        })
    for ["login", "admin"] as permission
        builder.endpoint({
            path: "/${permission}/private"
            module: module
            handler: "echo"
            auth: permission
        })
    builder.endpoint({
        path: "/wild/*"
        module: module
        handler: "echo"
        auth: "anonymous"
    })
    builder.endpoint({
        path: "/wild/exact"
        module: module
        handler: "serialized"
        auth: "anonymous"
    })
    for ["/user/{userId}", "/org/{orgId}/user/{userId}", "/only/{id}", "/choose/{first}/fixed", "/choose/static/{second}"] as route
        builder.endpoint({
            path: route
            module: module
            handler: "parameters"
            auth: "anonymous"
        })
    builder.endpoint({
        path: "/user/*"
        module: module
        handler: "echo"
        auth: "anonymous"
    })
    builder.endpoint({
        path: "/user/me"
        module: module
        handler: "serialized"
        auth: "anonymous"
    })
    for ["register", "validate", "request"] as name
        handler = name
        if name == "request"
            handler = "audit"
        builder.event({
            name: name
            module: module
            handler: handler
        })
    server = builder.build()
    return chain server.start()
      then(address)
        capture run
        capture server
        address.server = server
        return run(address)
      finally
        capture server
        return server.close()

call(address, endpoint, input = null, token = null, extra = null)
    if input == null
        input = {}
    headers = {
        "Content-Type": "application/json"
    }
    if token != null
        headers.Authorization = "Bearer ${token}"
    if extra != null
        Object/assign(headers, extra)
    body = input
    if !is_string(body)
        body = to_json(input)
    return chain fetch("http://127.0.0.1:${address.port}${endpoint}", {
        method: "POST"
        headers: headers
        body: body
    })
      then(res)
        return chain res.json()
          then(body)
            capture res
            return {
                status: res.status
                body: body
                token: res.headers.get("x-lango-token")
                marker: res.headers.get("x-example")
                retry: res.headers.get("retry-after")
                authChange: res.headers.get("x-lango-auth-change")
                needLogin: res.headers.get("x-lango-need-login")
                challenge: res.headers.get("www-authenticate")
            }

staleToken()
    config = options(process.cwd(), {
        key: "01234567890123456789012345678901"
    })
    service = new Tokens(config)
    claims = service.create()
    claims.iat = claims.iat - 5
    claims.exp = claims.iat + config.ttlSeconds
    claims.validatedAt = Date/now() - 2000
    return service.sign(claims)

wait(ms)
    pending = new Promise((resolve)
        capture ms
        setTimeout(resolve, ms)
    )
    return pending

test "public package exports only Server and Builder"
    keys = Object/keys(api)
    keys.sort()
    check/deepStrictEqual(keys, ["Builder", "Server"])

test "HTTP handler runs in a worker with contexts, registration, headers and JSON"
    run = (address)
        return chain call(address, "/echo", {
            value: "hello"
            status: 201
        })
          then(result)
            assert result.status == 201
            assert result.body.value == "hello"
            assert result.body.threadId > 0
            assert result.body.registered == true
            assert result.marker == "yes"
            assert is_string(result.token)
            return null
    return withServer({}, run)

test "login auth, exact roles, token updates and logout"
    run = (address)
        return chain call(address, "/login/private")
          then(result)
            capture address
            assert result.status == 401
            assert result.token == null
            return call(address, "/login")
          then(login)
            capture address
            assert login.status == 200
            return chain call(address, "/login/private", {}, login.token)
              then(result)
                capture address
                capture login
                assert result.status == 200
                assert result.body.clientId == login.body.clientId
                return call(address, "/admin/private", {}, login.token)
              then(result)
                capture address
                capture login
                assert result.status == 401
                return call(address, "/logout", {}, login.token)
              then(result)
                capture address
                assert result.status == 200
                return call(address, "/login/private", {}, result.token)
              then(result)
                assert result.status == 401
                return null
    return withServer({}, run)

test "Promise results and class toJSON serialize inside the worker"
    run = (address)
        return chain call(address, "/pause", {
            value: "async"
            ms: 20
        })
          then(result)
            capture address
            assert result.status == 200
            assert result.body.value == "async"
            return call(address, "/serialized", {
                value: "custom"
            })
          then(result)
            assert result.status == 200
            assert result.body.wrapped == "custom"
            return null
    return withServer({}, run)

test "malformed JSON, unsupported media/method, unknown route and circular output"
    run = (address)
        return chain call(address, "/echo", "{")
          then(result)
            capture address
            assert result.status == 400
            return call(address, "/missing")
          then(result)
            capture address
            assert result.status == 404
            return call(address, "/circular")
          then(result)
            capture address
            assert result.status == 500
            assert result.token == null
            return fetch("http://127.0.0.1:${address.port}/echo")
          then(result)
            capture address
            assert result.status == 405
            return call(address, "/echo", {}, null, {
                "Content-Type": "text/plain"
            })
          then(result)
            assert result.status == 415
            return null
    return withServer({}, run)

test "exact routes beat wildcard routes and wildcard retains the actual path"
    run = (address)
        return chain call(address, "/wild/child", {
            value: 1
        })
          then(result)
            capture address
            assert result.body.path == "/wild/child"
            return call(address, "/wild/exact", {
                value: 2
            })
          then(result)
            assert result.body.wrapped == 2
            return null
    return withServer({}, run)

test "registration and handler failures never issue changed tokens or private details"
    run = (address)
        return chain call(address, "/echo", {}, null, {
            "x-register": "fail"
        })
          then(result)
            capture address
            assert result.status == 500
            assert result.token == null
            return call(address, "/fail")
          then(result)
            assert result.status == 500
            assert result.token == null
            assert result.body.error == "InternalServerError"
            return null
    return withServer({}, run)

test "invalid signatures and expired tokens fail even at anonymous endpoints"
    run = (address)
        return chain call(address, "/echo", {}, "invalid")
          then(result)
            capture address
            assert result.status == 401
            assert result.token == null
            return call(address, "/missing", {}, "invalid")
          then(result)
            assert result.status == 401
            assert result.token == null
            return null
    return withServer({}, run)

test "validation false, exception, mutation and timeout have distinct failures"
    run = (address)
        token = staleToken()
        return chain call(address, "/echo", {}, token, {
            "x-validate": "false"
        })
          then(result)
            capture address
            capture token
            assert result.status == 401
            return call(address, "/echo", {}, token, {
                "x-validate": "error"
            })
          then(result)
            capture address
            capture token
            assert result.status == 500
            return call(address, "/echo", {}, token, {
                "x-validate": "mutate"
            })
          then(result)
            capture address
            capture token
            assert result.status == 500
            return call(address, "/echo", {}, token, {
                "x-validate": "block"
            })
          then(result)
            assert result.status == 504
            assert result.token == null
            return null
    return withServer({}, run)

test "successful validation timestamp travels in JWT and skips immediate revalidation"
    file = path/resolve(".test-output/validation.log")
    fs/writeFileSync(file, "")
    run = (address)
        capture file
        return chain call(address, "/echo", {}, staleToken(), {
            "x-record": file
        })
          then(result)
            capture address
            capture file
            assert result.status == 200
            assert is_string(result.token)
            return call(address, "/echo", {}, result.token, {
                "x-record": file
                "x-validate": "false"
            })
          then(result)
            capture file
            capture fs
            assert result.status == 200
            text = fs/readFileSync(file, "utf8")
            text = text.trim()
            lines = text.split("\n")
            assert lines.length == 1
            return null
    return withServer({}, run)

test "request events observe JSON and failures preserve the completed result"
    file = path/resolve(".test-output/audit.log")
    fs/writeFileSync(file, "")
    run = (address)
        capture file
        return chain call(address, "/echo", {
            value: "audit"
        }, null, {
            "x-record": file
            "x-audit": "error"
        })
          then(result)
            capture file
            capture fs
            assert result.status == 200
            assert result.body.value == "audit"
            text = fs/readFileSync(file, "utf8")
            record = from_json(text.trim())
            input = from_json(record.input)
            output = from_json(record.output)
            assert input.value == "audit"
            assert output.value == "audit"
            return null
    return withServer({
        requestEvent: true
    }, run)

test "a blocking Request event is killed without losing the prepared HTTP result"
    run = (address)
        return chain call(address, "/echo", {
            value: "retained"
        }, null, {
            "x-audit": "block"
        })
          then(result)
            capture address
            assert result.status == 200
            assert result.body.value == "retained"
            assert is_string(result.token)
            return call(address, "/echo")
          then(result)
            assert result.status == 200
            return null
    return withServer({
        requestEvent: true
    }, run)

test "worker crashes and synchronous request deadlines recover without retry"
    run = (address)
        return chain call(address, "/crash")
          then(result)
            capture address
            assert result.status == 500
            return call(address, "/pause", {
                block: true
                ms: 1500
            })
          then(result)
            capture address
            assert result.status == 504
            return call(address, "/echo")
          then(result)
            assert result.status == 200
            return null
    return withServer({
        requestTimeoutMs: 500
    }, run)

test "full queues reject extra requests and graceful close drains accepted work"
    run = (address)
        first = call(address, "/pause", {
            ms: 100
        })
        return chain wait(30)
          then(ignored)
            capture address
            return call(address, "/echo")
          then(result)
            capture first
            capture address
            assert result.status == 503
            return closeAndWait(address.server, first)
          then(result)
            assert result.status == 200
            return null
    return withServer({
        maxQueue: 0
    }, run)

test "oversized bodies are rejected before dispatch"
    run = (address)
        return chain call(address, "/echo", {
            value: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        })
          then(result)
            assert result.status == 413
            assert result.token == null
            return null
    return withServer({
        bodyLimit: 100
    }, run)

test "missing exports fail startup and close remains safe"
    builder = new api/Builder(process.cwd())
    builder.configure({
        port: 0
        workers: 1
        key: "01234567890123456789012345678901"
        startupTimeoutMs: 500
    })
    builder.endpoint({
        path: "/bad"
        module: path/resolve(".test-output/handlers.mjs")
        handler: "missingExport"
    })
    server = builder.build()
    return chain server.start()
      then(address)
        return false
      catch(error)
        return true
      then(failed)
        assert failed
        return null
      finally
        capture server
        return server.close()

closeAndWait(server, pending)
    return chain server.close()
      then(ignored)
        capture pending
        return pending

test "queued deadlines never execute the canceled handler"
    file = path/resolve(".test-output/queue.log")
    fs/rmSync(file, {
        force: true
    })
    run = (address)
        capture file
        first = call(address, "/echo", {}, null, {
            "x-audit": "block"
        })
        return queuedScenario(address, file, first)
    return withServer({
        requestTimeoutMs: 100
        eventTimeoutMs: 300
        requestEvent: true
    }, run)

queuedScenario(address, file, first)
    return chain wait(30)
      then(ignored)
        capture address
        capture file
        return call(address, "/echo", {}, null, {
            "x-record": file
        })
      then(result)
        capture first
        assert result.status == 504
        return first
      then(result)
        capture file
        capture fs
        assert result.status == 200
        assert !fs/existsSync(file)
        return null

test "a second start rejects and repeated close is safe"
    run = (address)
        return chain address.server.start()
          then(result)
            return false
          catch(error)
            return true
          then(rejected)
            assert rejected
            return null
    return withServer({}, run)

test "a shutdown deadline reports failure and releases blocked workers"
    run = (address)
        first = call(address, "/pause", {
            ms: 3000
        })
        observed = consumeFailure(first)
        return chain wait(40)
          then(ignored)
            capture address
            return address.server.close()
          then(ignored)
            return false
          catch(error)
            return true
          then(rejected)
            capture observed
            assert rejected
            return observed
    result = withServer({
        shutdownTimeoutMs: 100
    }, run)
    return chain result
      then(ignored)
        return false
      catch(error)
        assert error == "Server shutdown timed out"
        return true
      then(rejected)
        assert rejected
        return null

consumeFailure(pending)
    return chain pending
      catch(error)
        return null


raw(address, stalled, oversized)
    pending = new Promise((resolve, reject)
        capture address
        capture stalled
        capture oversized
        capture http
        req = http/request({
            host: "127.0.0.1"
            port: address.port
            path: "/echo"
            method: "POST"
            headers: {
                "Content-Type": "application/json"
            }
        })
        req.on("error", reject)
        req.on("response", (res)
            capture resolve
            res.resume()
            resolve(res.statusCode)
        )
        if stalled
            req.write("{")
          else
              if oversized
                  req.write("{\"value\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}")
                else
                    req.write("{}")
              req.end()
    )
    return pending

test "chunked bodies honor byte limits and stalled uploads honor body deadlines"
    run = (address)
        return chain raw(address, false, true)
          then(status)
            capture address
            assert status == 413
            return raw(address, true, false)
          then(status)
            capture address
            assert status == 408
            return call(address, "/echo")
          then(result)
            assert result.status == 200
            return null
    return withServer({
        bodyLimit: 100
        bodyTimeoutMs: 50
    }, run)

test "validation and explicit renewal extend successful requests without reviving expired tokens"
    config = options(process.cwd(), {
        key: "01234567890123456789012345678901"
    })
    service = new Tokens(config)
    signed = staleToken()
    original = service.read("Bearer ${signed}")
    run = (address)
        capture signed
        return chain call(address, "/echo", {}, signed)
          then(result)
            capture signed
            capture original
            capture service
            capture address
            assert result.status == 200
            validated = service.read("Bearer ${result.token}")
            assert validated.exp > original.exp
            assert validated.validatedAt > original.validatedAt
            return call(address, "/renew", {}, signed)
          then(result)
            capture signed
            capture original
            capture service
            capture address
            assert result.status == 200
            renewed = service.read("Bearer ${result.token}")
            assert renewed.exp > original.exp
            assert renewed.clientId == original.clientId
            return call(address, "/renew", {
                mode: "reject"
            }, signed)
          then(result)
            capture signed
            capture address
            assert result.status == 429
            assert result.body.error == "RenewalRejected"
            assert result.retry == "60"
            assert result.token == null
            return call(address, "/renew", {
                mode: "throw"
            }, signed)
          then(result)
            capture signed
            capture address
            assert result.status == 500
            assert result.token == null
            return call(address, "/renew", {
                mode: "circular"
            }, signed)
          then(result)
            capture service
            capture address
            assert result.status == 500
            assert result.token == null
            short = service.create()
            short.exp = short.iat + 1
            token = service.sign(short)
            return call(address, "/renew", {
                mode: "delay"
                ms: 1200
            }, token)
          then(result)
            assert result.status == 401
            assert result.token == null
            return null
    return withServer({
        requestTimeoutMs: 4000
    }, run)


test "worker routing merges decoded path parameters before Register and keeps exact/wildcard precedence"
    run = (address)
        return chain call(address, "/user/007", {
            userId: "spoofed"
            value: "kept"
        })
          then(result)
            capture address
            assert result.status == 200
            assert result.body.input.userId == "007"
            assert result.body.input.value == "kept"
            assert result.body.registeredUserId == "007"
            return call(address, "/org/acme/user/A%20B")
          then(result)
            capture address
            assert result.body.input.orgId == "acme"
            assert result.body.input.userId == "A B"
            assert result.body.path == "/org/acme/user/A%20B"
            return call(address, "/user/%252F")
          then(result)
            capture address
            assert result.body.input.userId == "%2F"
            return call(address, "/user/%2F")
          then(result)
            capture address
            assert result.body.input.userId == "/"
            return call(address, "/user/%C4%B0pek")
          then(result)
            capture address
            assert result.body.input.userId == "İpek"
            return call(address, "/user/me", {
                value: "exact"
            })
          then(result)
            capture address
            assert result.body.wrapped == "exact"
            return call(address, "/user/a/b", {
                value: "wildcard"
            })
          then(result)
            capture address
            assert result.body.value == "wildcard"
            return call(address, "/choose/static/fixed")
          then(result)
            capture address
            assert result.body.input.second == "fixed"
            assert !Object/hasOwn(result.body.input, "first")
            return call(address, "/only/")
          then(result)
            capture address
            assert result.status == 404
            return call(address, "/user/%E0%A4%A")
          then(result)
            assert result.status == 400
            assert result.body.error == "InvalidPath"
            assert result.token == null
            return null
    return withServer({}, run)


test "Register receives observed IP and User-Agent independently of JSON metadata"
    run = (address)
        return chain call(address, "/user/007", {
            inspectRegistration: true
            ip: "spoofed-body-ip"
            userAgent: "spoofed-body-agent"
        }, null, {
            "User-Agent": "Lango registration test"
            "X-Forwarded-For": "203.0.113.9"
        })
          then(result)
            capture address
            assert result.status == 200
            metadata = result.body.registration
            assert metadata.ip == "127.0.0.1"
            assert metadata.userAgent == "Lango registration test"
            assert is_string(metadata.clientId)
            assert result.body.registeredUserId == "007"
            assert result.body.input.ip == "spoofed-body-ip"
            assert result.body.input.userAgent == "spoofed-body-agent"
            return call(address, "/user/008", {
                inspectRegistration: true
            }, null, {
                "User-Agent": ""
            })
          then(result)
            assert result.status == 200
            assert result.body.registration.userAgent == ""
            assert !("ip" in result.body.input)
            assert !("userAgent" in result.body.input)
    return withServer({}, run)


test "response.reject stops sync and Promise handlers without publishing token changes"
    run = (address)
        return chain call(address, "/rejectReply", {
            status: 401
            code: "InvalidCredentials"
        })
          then(result)
            capture address
            assert result.status == 401
            assert result.body.error == "InvalidCredentials"
            assert result.challenge == "Bearer"
            assert result.token == null
            return call(address, "/rejectReply", {
                status: 403
                code: "Forbidden"
                promise: true
            })
          then(result)
            capture address
            assert result.status == 403
            assert result.body.error == "Forbidden"
            assert result.token == null
            return call(address, "/rejectReply", {
                status: 200
                code: "InvalidCredentials"
            })
          then(result)
            capture address
            assert result.status == 500
            assert result.body.error == "InternalServerError"
            assert result.token == null
            return call(address, "/rejectReply", {
                status: 401
                code: "bla bla"
            })
          then(result)
            capture address
            assert result.status == 500
            assert result.body.error == "InternalServerError"
            assert result.token == null
            return call(address, "/echo")
          then(result)
            assert result.status == 200
            assert result.body.auth == ""
    return withServer({}, run)


test "configured origin rejects before lifecycle callbacks and accepts only the configured browser origin"
    run = (address)
        return chain call(address, "/echo", {}, null, {
            "x-register": "fail"
        })
          then(result)
            capture address
            assert result.status == 403 and result.body.error == "OriginRejected"
            assert result.token == null
            return call(address, "/echo", {}, null, {
                Origin: "https://attacker.example"
            })
          then(result)
            capture address
            assert result.status == 403 and result.token == null
            return call(address, "/echo", {}, null, {
                Origin: "https://app.example"
                "Sec-Fetch-Site": "cross-site"
            })
          then(result)
            capture address
            assert result.status == 403 and result.token == null
            return call(address, "/echo", {}, null, {
                Origin: "https://app.example"
                "Sec-Fetch-Site": "same-origin"
            })
          then(result)
            assert result.status == 200 and result.body.registered
    return withServer({
        origin: {
            url: "https://app.example"
        }
    }, run)

test "optional Origin permits missing headers but does not accept an unrelated Origin"
    run = (address)
        return chain call(address, "/echo")
          then(result)
            capture address
            assert result.status == 200
            return call(address, "/echo", {}, null, {
                Origin: "null"
            })
          then(result)
            assert result.status == 403 and result.token == null
    return withServer({
        origin: {
            url: "https://app.example"
            required: false
        }
    }, run)


policyToken(name, authenticatedAt = null)
    config = options(process.cwd(), {
        key: "01234567890123456789012345678901"
    })
    service = new Tokens(config)
    token = new Token(service.create())
    token.addPolicy(name)
    if authenticatedAt != null
        token.set("authenticatedAt", authenticatedAt)
    return service.sign(token.snapshot())

test "built-in policies authorize plain endpoints without middleware and expose readonly route metadata"
    run = (address)
        return chain call(address, "/policy/login")
          then(result)
            capture address
            assert result.status == 401 and result.body.error == "LoginRequired"
            assert result.needLogin == "1"
            assert result.body.needLogin.policy == "login"
            assert result.token == null
            return call(address, "/policy/admin", {}, policyToken("login"))
          then(result)
            capture address
            assert result.status == 403 and result.body.error == "Forbidden"
            assert result.token == null
            return call(address, "/policy/admin", {}, policyToken("admin"))
          then(result)
            assert result.status == 200
            assert result.body.frozen
            assert result.body.route.policy == "admin"
            assert result.body.route.reauthSeconds == 0
            assert result.body.policies[0] == "admin"
    return withServer({}, run)

test "built-in password freshness is checked per request independently of token validation freshness"
    run = (address)
        return chain call(address, "/policy/fresh", {}, policyToken("login", Date/now()))
          then(result)
            capture address
            assert result.status == 200
            return call(address, "/policy/fresh", {
                reauthSeconds: 0
                authenticatedAt: Date/now()
            }, policyToken("login", Date/now() - 120000))
          then(result)
            capture address
            assert result.status == 403 and result.body.error == "ReauthenticationRequired"
            assert result.token == null
            return call(address, "/policy/login", {}, policyToken("login", Date/now() - 120000))
          then(result)
            capture address
            assert result.status == 200
            return call(address, "/policy/fresh", {}, policyToken("login"))
          then(result)
            capture address
            assert result.status == 403 and result.token == null
            return call(address, "/policy/fresh", {}, policyToken("login", Date/now() + 60000))
          then(result)
            assert result.status == 403 and result.body.error == "ReauthenticationRequired"
    return withServer({}, run)

test "login challenges identify pre-dispatch rejection and replay refuses an account change"
    run = (address)
        return chain call(address, "/policy/fresh", {}, policyToken("login"))
          then(result)
            capture address
            assert result.status == 403 and result.needLogin == "1"
            assert result.body.needLogin.reason == "ReauthenticationRequired"
            assert result.body.needLogin.reauthSeconds == 60
            return call(address, "/policy/fresh", {}, policyToken("login", Date/now()), {
                "X-Lango-Expected-User": to_json("someone-else")
            })
          then(result)
            capture address
            assert result.status == 409 and result.body.error == "IdentityChanged"
            assert result.needLogin == null and result.token == null
            return call(address, "/rejectReply")
          then(result)
            assert result.needLogin == null
    return withServer({}, run)

test "central policy defaults are resolved before workers and reflected in trusted route metadata"
    builder = new api/Builder(process.cwd())
    builder.configure({
        port: 0
        workers: 1
        key: "01234567890123456789012345678901"
        policies: {
            reauthSeconds: 120
            items: [{
                name: "login"
            }, {
                name: "admin"
                reauthSeconds: 300
            }]
        }
    })
    builder.endpoint({
        path: "/central"
        module: path/resolve(".test-output/handlers.mjs")
        handler: "policyEcho"
        policy: "login"
    })
    server = builder.build()
    return chain server.start()
      then(address)
        return chain call(address, "/central", {}, policyToken("login", Date/now()))
          then(result)
            capture address
            assert result.status == 200
            assert result.body.route.reauthSeconds == 120
            return call(address, "/central", {}, policyToken("login", Date/now() - 121000))
          then(result)
            assert result.status == 403 and result.needLogin == "1"
            assert result.body.needLogin.reauthSeconds == 120
      finally
        capture server
        return server.close()

test "successful authentication changes emit an opaque marker while renewal and rejected requests do not"
    run = (address)
        return chain call(address, "/login")
          then(result)
            capture address
            assert is_string(result.authChange) and result.authChange.startsWith("v1:")
            return call(address, "/echo", {}, result.token)
          then(result)
            capture address
            assert result.authChange == null
            return call(address, "/logout", {}, result.token)
          then(result)
            capture address
            assert is_string(result.authChange) and result.authChange.startsWith("v1:")
            return call(address, "/policy/login")
          then(result)
            assert result.authChange == null
    return withServer({}, run)

import js "node:crypto" as crypto
import js global Buffer
import js global Array

export hashPassword(password)
export verifyPassword(password, stored)
export secret()
export digest(value)
export equalDigest(left, right)

global dummy = hashPassword("This is not an application account password.")

secret()
    bytes = crypto/randomBytes(32)
    return bytes.toString("hex")

digest(value)
    hash = crypto/createHash("sha256")
    hash.update(value)
    return hash.digest("hex")

equalDigest(left, right)
    if !is_string(left) or !is_string(right) or left.length != 64 or right.length != 64
        return false
    first = Buffer/from(left, "hex")
    second = Buffer/from(right, "hex")
    if first.length != 32 or second.length != 32
        return false
    return crypto/timingSafeEqual(first, second)

hashPassword(password)
    if !is_string(password) or Buffer/byteLength(password) > 512
        throw "Password must contain at least 15 characters and at most 512 UTF-8 bytes"
    characters = Array/from(password)
    if characters.length < 15
        throw "Password must contain at least 15 characters and at most 512 UTF-8 bytes"
    salt = secret()
    hash = derive(password, salt)
    return "scrypt:131072:8:1:${salt}:${hash}"

verifyPassword(password, stored)
    global dummy
    known = stored != null
    if !known
        stored = dummy
    if !is_string(password) or Buffer/byteLength(password) > 512
        return false
    parts = stored.split(":")
    if parts.length != 6 or parts[0] != "scrypt" or parts[1] != "131072" or parts[2] != "8" or parts[3] != "1"
        throw "Unsupported password record"
    actual = derive(password, parts[4])
    return equalDigest(actual, parts[5]) and known

derive(password, salt)
    hash = crypto/scryptSync(password, salt, 32, {
        N: 131072
        r: 8
        p: 1
        maxmem: 268435456
    })
    return hash.toString("hex")
